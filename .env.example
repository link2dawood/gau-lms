# GAU Interactive Textbook Platform — environment configuration template.
#
# Copy to .env and fill in real values. The .env file is never committed
# (DECISIONS.md D-004); this template is, and every variable the platform reads
# must appear here with a placeholder.
#
# Variables are grouped by the task that introduced them. Django and Canvas LTI
# settings are added by tasks 0.3 and 1.2.

# ---------------------------------------------------------------------------
# Host ports (local development only; the server exposes 80/443 — task 4.8)
# ---------------------------------------------------------------------------
# The single entry point. Everything reaches the platform through Nginx.
HTTP_PORT=8080
# Backing stores bind to 127.0.0.1 for psql/redis-cli access during development.
# Change any of these if the port is already taken by another project on your
# machine; only the host side moves, the compose network is unaffected.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MEILI_HOST_PORT=7700

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=gau_textbook
POSTGRES_USER=gau
# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-before-first-run
# Consumed by Django in task 0.3. Host and port are service names on the
# compose network, not localhost.
DATABASE_URL=postgres://gau:change-me-before-first-run@postgres:5432/gau_textbook

# ---------------------------------------------------------------------------
# Redis — cache, Celery broker and result backend, LTI state/nonce store
# ---------------------------------------------------------------------------
# Logical databases are separated so flushing the cache cannot drop a queued
# import job or an in-flight LTI nonce.
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
LTI_STATE_REDIS_URL=redis://redis:6379/3
# Sessions. Separate from the page cache because a session is not cache:
# clearing a stale page must not sign every reader out mid-chapter, and an LRU
# eviction policy must never be able to drop one.
SESSION_REDIS_URL=redis://redis:6379/4

# ---------------------------------------------------------------------------
# Meilisearch
# ---------------------------------------------------------------------------
MEILISEARCH_URL=http://meilisearch:7700
# Required, minimum 16 bytes. Generate with: openssl rand -base64 32
MEILI_MASTER_KEY=change-me-before-first-run
# "development" exposes the Meilisearch web UI and relaxes key checks.
# Must be "production" on any deployed environment.
MEILI_ENV=development

# ---------------------------------------------------------------------------
# Process tuning
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Django core
# ---------------------------------------------------------------------------
# Required, no default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-before-first-run

# core.settings.dev | core.settings.prod | core.settings.test
DJANGO_SETTINGS_MODULE=core.settings.dev

# Development only. Production settings force DEBUG off and ignore this.
DJANGO_DEBUG=true

# Comma-separated. Required and non-empty under production settings.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Comma-separated absolute origins. Required and non-empty under production
# settings; must be https:// there.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Public origin of the tool. Used to build the LTI redirect URIs and the JWKS
# URL given to the Canvas administrator (task 1.17). No trailing slash.
PLATFORM_BASE_URL=http://localhost:8080

# Canvas hosts allowed to embed the reader in an iframe. Enforced as a
# Content-Security-Policy frame-ancestors directive in task 4.4.
# Example: canvas.instructure.com,gau.instructure.com
CANVAS_FRAME_ANCESTORS=

# Path to the JSON file listing the Canvas platforms this tool trusts: issuer,
# client_id, deployment_ids, auth_login_url, auth_token_url, jwks_url. The
# Canvas administrator supplies these when the developer key is created.
# Apply it with: python manage.py sync_lti_platforms
# The file is never committed — it names a specific institution's Canvas.
LTI_PLATFORMS_FILE=/app/lti-platforms.json

# Directory holding this tool's RSA private keys, one PEM per key named by its
# kid. Create a key with: python manage.py create_lti_key
# The public halves are served at <PLATFORM_BASE_URL>/lti/jwks/ for Canvas.
# Never committed, and on the server this must be a persistent volume — losing
# it means every Canvas registration has to be re-pointed at a new key.
LTI_TOOL_KEY_DIR=/app/lti-keys

DJANGO_LOG_LEVEL=INFO
# Echo every SQL statement to the console. Development only, very noisy.
DJANGO_LOG_SQL=false

DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# Django — production security (production settings only)
# ---------------------------------------------------------------------------
# Leave the defaults unless there is a specific reason. HTTPS is mandatory for
# LTI 1.3, and the reader runs in a Canvas iframe, so its session cookie must be
# SameSite=None, which browsers honour only when it is also Secure.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
# Only enable after the domain is confirmed permanently HTTPS-only. Preload
# submission is difficult to reverse.
DJANGO_HSTS_PRELOAD=false

# ---------------------------------------------------------------------------
# Limits and tuning
# ---------------------------------------------------------------------------
# Session lifetime in seconds. A Canvas launch is a working session, not a
# long-lived login.
SESSION_COOKIE_AGE=43200
# Seconds a database connection is reused between requests.
DATABASE_CONN_MAX_AGE=60
# Maximum NON-FILE request body in bytes (JSON, form fields). Does NOT limit
# uploaded files. The largest legitimate value is one section's Tiptap JSON.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
# Bytes at which an uploaded file is streamed to disk instead of held in memory.
# Not a size limit. The ceiling on uploaded files is client_max_body_size in
# docker/nginx/nginx.conf (currently 64m).
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
# Celery task limits in seconds. A 338-page PDF import is the long pole.
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
# How often every course's Canvas roster is reconciled, in seconds. Canvas does
# not notify the tool when someone leaves a course; only a roster read finds
# out. Lower means a departed student loses access sooner and Canvas is polled
# more often. A launch always reconciles the launching user immediately.
ROSTER_SYNC_INTERVAL_SECONDS=21600

# ---------------------------------------------------------------------------
# Search index namespace
# ---------------------------------------------------------------------------
# Prefix for Meilisearch index names, so staging and production can share an
# instance without one reindex clobbering the other.
MEILISEARCH_INDEX_PREFIX=gau

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Base URL the BROWSER uses for API calls. Empty means same-origin, which is
# correct whenever Nginx fronts both the app and the API — the normal case.
# Only set this if the frontend is ever served from a different origin.
NEXT_PUBLIC_API_BASE_URL=

# Base URL the SERVER uses for API calls during React Server Component
# rendering. Set by docker-compose.yml to reach Django over the private
# network, skipping a round trip back out through Nginx.
INTERNAL_API_BASE_URL=http://backend:8000

# Interface preview at /preview: screens built with sample content before the
# content API exists. Off unless exactly "true". Never enable on a deployed
# environment.
ENABLE_UI_PREVIEW=false
