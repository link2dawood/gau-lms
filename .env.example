# GAU Interactive Textbook Platform — environment configuration template.
#
# Copy to .env and fill in real values. The .env file is never committed
# (DECISIONS.md D-004); this template is, and every variable the platform reads
# must appear here with a placeholder.
#
# Variables are grouped by the task that introduced them. Django and Canvas LTI
# settings are added by tasks 0.3 and 1.2.

# ---------------------------------------------------------------------------
# Host ports (local development only; the server exposes 80/443 — task 4.8)
# ---------------------------------------------------------------------------
# The single entry point. Everything reaches the platform through Nginx.
HTTP_PORT=8080
# Backing stores bind to 127.0.0.1 for psql/redis-cli access during development.
# Change any of these if the port is already taken by another project on your
# machine; only the host side moves, the compose network is unaffected.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MEILI_HOST_PORT=7700

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=gau_textbook
POSTGRES_USER=gau
# Required. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-before-first-run
# Consumed by Django in task 0.3. Host and port are service names on the
# compose network, not localhost.
DATABASE_URL=postgres://gau:change-me-before-first-run@postgres:5432/gau_textbook

# ---------------------------------------------------------------------------
# Redis — cache, Celery broker and result backend, LTI state/nonce store
# ---------------------------------------------------------------------------
# Logical databases are separated so flushing the cache cannot drop a queued
# import job or an in-flight LTI nonce.
REDIS_CACHE_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
LTI_STATE_REDIS_URL=redis://redis:6379/3

# ---------------------------------------------------------------------------
# Meilisearch
# ---------------------------------------------------------------------------
MEILISEARCH_URL=http://meilisearch:7700
# Required, minimum 16 bytes. Generate with: openssl rand -base64 32
MEILI_MASTER_KEY=change-me-before-first-run
# "development" exposes the Meilisearch web UI and relaxes key checks.
# Must be "production" on any deployed environment.
MEILI_ENV=development

# ---------------------------------------------------------------------------
# Process tuning
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
CELERY_CONCURRENCY=2
