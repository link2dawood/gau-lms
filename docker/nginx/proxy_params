# Shared upstream proxy behaviour, included by every proxying location.
#
# Included rather than inherited on purpose: nginx does not merge
# proxy_set_header across levels — a single proxy_set_header inside a location
# discards every header set above it. Including this file in each location
# keeps Host and the X-Forwarded-* set intact even where a location adds
# websocket headers of its own.
#
# X-Forwarded-Proto carries the original scheme through TLS termination, which
# Django needs to issue the SameSite=None; Secure cookies a Canvas iframe
# launch requires (task 1.9) and to build correct absolute URLs.

proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $forwarded_scheme;
proxy_set_header X-Forwarded-Host  $host;

proxy_http_version 1.1;
proxy_redirect     off;

proxy_connect_timeout 10s;
proxy_send_timeout    60s;
proxy_read_timeout    60s;
